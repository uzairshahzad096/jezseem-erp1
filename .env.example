# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=jezseem_erp
POSTGRES_USER=jezseem
POSTGRES_PASSWORD=change-me

# --- Backend ---
# localhost — the backend runs natively, not inside a container.
DATABASE_URL=postgresql+psycopg://jezseem:change-me@localhost:5432/jezseem_erp
SECRET_KEY=change-me-to-a-long-random-string

# DEVELOPMENT ONLY — opens the dashboard without signing in.
# Every request runs as DEV_USER_USERNAME and all permission checks pass.
# Set to false before this system holds real data; the backend refuses to
# start with AUTH_DISABLED=true and ENVIRONMENT=production.
AUTH_DISABLED=true
DEV_USER_USERNAME=admin
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Redis / Celery (not used yet — leave as is) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- First-run seed (used once by: python -m app.core.seed) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@jezseem.local
SEED_ADMIN_PASSWORD=change-me-min-10-chars
